# Copy to .env and fill in locally. Do not commit secrets.

# Frontend
VITE_BACKEND_URL=http://localhost:8000

# Backend (loaded automatically from backend/.env, then this file, on startup)
APP_ENV=development

# Application connection. In production this MUST be a non-BYPASSRLS,
# non-superuser role (recommended name: app_user). Do not use the Supabase
# postgres role for the API — that role bypasses row-level security.
# The API uses DATABASE_URL as supplied and does not rewrite the username.
#
# Direct Postgres (preferred for this API; it uses SET LOCAL for RLS).
# Add credentials only in your private .env, never in this template.
#   postgresql://app_user@localhost:5432/postgres
# Supabase: copy the dashboard string for the app role. Direct connections
# use `app_user`. A pooler may show `app_user.<project-ref>` — use that form
# only when the dashboard shows it. Prefer a direct or session-mode
# connection over transaction-mode pooling (port 6543).
DATABASE_URL=postgresql://app_user@localhost:5432/postgres

# Optional privileged URL for schema/migrations (table owner / postgres).
# Defaults to DATABASE_URL when unset. Never commit real credentials.
# DATABASE_ADMIN_URL=postgresql://postgres@localhost:5432/postgres
DATABASE_ADMIN_URL=

JWT_SECRET=
JWT_EXPIRY_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080
AI_BUDGET_SECONDS=8
AI_CACHE_TTL_SECONDS=60

# Optional OpenAI-compatible model used by POST /api/chat and, when enabled,
# to rephrase deterministic insight text. Leave the key empty to keep chat
# unavailable and dashboards fully deterministic.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
AI_NARRATIVE_ENABLED=false

# Speech To Text - Groq Whisper (POST /api/speech/transcribe)
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo
# Leave empty for automatic Arabic/English detection
STT_LANGUAGE=

# Text To Speech - ElevenLabs (POST /api/speech/synthesize)
TTS_BASE_URL=https://api.elevenlabs.io/v1
TTS_API_KEY=
TTS_MODEL=eleven_multilingual_v2
TTS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
TTS_OUTPUT_FORMAT=mp3_44100_128
TTS_TIMEOUT_SECONDS=120
